// Regenerates lib/city/protoDims.ts from the baked prototypes: node --import tsx tools/gen-proto-dims.mts
import { writeFileSync } from "node:fs";
import { PROTOTYPE_DEFS, bakePrototype } from "../components/city/prototypes";

const rows = PROTOTYPE_DEFS.map((d) => {
  const p = bakePrototype(d);
  const lite = bakePrototype(d, { minPart: 1.3 });
  console.log(d.key.padEnd(10), `w ${p.width} d ${p.depth} h ${p.height} tris ${p.triangles} low ${lite.triangles}`);
  return `  "${d.key}": { tier: "${d.tier}", width: ${p.width}, depth: ${p.depth}, height: ${p.height}, triangles: ${p.triangles} },`;
});
writeFileSync(
  new URL("../lib/city/protoDims.ts", import.meta.url),
  `// GENERATED by tools/gen-proto-dims.mts from components/city/prototypes.ts. Do not edit by hand.
// Pure data so the layout stays free of three.js.
export interface ProtoDim {
  tier: "tower" | "mid" | "shop" | "vault";
  width: number;
  depth: number;
  height: number;
  triangles: number;
}

export const PROTO_DIMS: Record<string, ProtoDim> = {
${rows.join("\n")}
};
`,
);
